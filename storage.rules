rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function roleOf(uid) {
      return firestore.get(/databases/(default)/documents/roles/$(uid)).data.role;
    }
    function hasRole(r) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
        && (roleOf(request.auth.uid) == r || roleOf(request.auth.uid) == 'staff');
    }
    function isStaff() { return hasRole('editor') || hasRole('requester'); }
    function req(requestId) {
      return firestore.get(/databases/(default)/documents/requests/$(requestId)).data;
    }
    function reqExists(requestId) {
      return firestore.exists(/databases/(default)/documents/requests/$(requestId));
    }
    // 1ファイルの上限（暫定 500MB。FigJamで未確定、lib/data/storage_service.dart と揃える）
    function sizeOk() { return request.resource.size <= 500 * 1024 * 1024; }

    // 依頼者が添付する動画・参考資料。依頼の作成前にアップロードするため、
    // 依頼者本人のフォルダにだけ書ける。編集者は担当（または未割り当て）の依頼のものだけ読める。
    match /uploads/{uid}/{requestId}/{file} {
      allow create, update: if hasRole('requester') && request.auth.uid == uid && sizeOk()
        && (request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/octet-stream');
      // 承認後、依頼者が添付素材を削除する（承認された動画だけを残す）。
      // 受付待ちの間は、依頼者が添付を差し替え・削除できる。
      allow delete: if hasRole('requester') && request.auth.uid == uid
        && reqExists(requestId)
        && req(requestId).requesterId == request.auth.uid
        && (req(requestId).approvedVersion != null
          || req(requestId).status == 'pending');
      allow read: if signedIn() && (
        request.auth.uid == uid || isStaff());
    }

    // 編集者が提出する初稿・修正動画。担当編集者が編集中／修正の間だけ書ける。
    match /videos/{requestId}/{version}/{file} {
      allow create, update: if hasRole('editor') && reqExists(requestId) && sizeOk()
        && req(requestId).editorId == request.auth.uid
        && (req(requestId).status == 'editing' || req(requestId).status == 'revision')
        && request.resource.contentType.matches('video/.*');
      // 承認後、依頼者が、承認されなかった提出動画を削除する。承認された版は消せない。
      allow delete: if hasRole('requester') && reqExists(requestId)
        && req(requestId).requesterId == request.auth.uid
        && req(requestId).approvedVersion != null
        && version != 'v' + string(req(requestId).approvedVersion);
      allow read: if signedIn() && reqExists(requestId) && (
        req(requestId).requesterId == request.auth.uid || isStaff());
    }
  }
}
